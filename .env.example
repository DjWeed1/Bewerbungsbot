# Copy to .env and fill in locally. Never commit real credentials.
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-gmail-app-password
MEIN_NAME=Your Name
ORDNER_HTML=./anzeigen
EXCEL_FILE=Bewerbungen.xlsx
LOG_FILE=bewerbungslog.txt

# Keep real sending disabled until you explicitly verify the generated emails.
SEND_REAL_EMAILS=False
ALLOW_REAL_EMAILS=False
DELAY_MIN_SECONDS=15
DELAY_MAX_SECONDS=45
